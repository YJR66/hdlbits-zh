{
 "appId":"net.hdlbits.zh.desktop",
 "productName":"HDLBits",
 "directories":{"output":"release"},
 "files":["desktop/**/*","dist/**/*","server.mjs","judge.mjs","package.json","!node_modules/**/*"],
 "extraResources":[
  {"from":".tools/ucrt64","to":"runtime","filter":["bin/*.exe","bin/*.dll","lib/ivl/**/*","share/licenses/**/*"]},
  {"from":".tools/manifest.json","to":"runtime-manifest.json"}
 ],
 "asar":true,
 "electronDist":"node_modules/electron/dist",
 "electronLanguages":["zh-CN","en-US"],
 "compression":"normal",
 "npmRebuild":false,
 "win":{"target":[{"target":"portable","arch":["x64"]}],"artifactName":"HDLBits-中文练习.exe","icon":"dist/assets/logo270.png"},
 "portable":{"requestExecutionLevel":"user"}
}
