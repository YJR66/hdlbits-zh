{
  "name": "hdlbits-zh-local",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "HDLBits 风格的中文本地 Verilog 学习工作台",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "desktop": "electron .",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:pack": "electron-builder --config electron-builder.json --win portable --x64",
    "desktop:unpacked": "electron-builder --config electron-builder.json --win --x64 --dir",
    "linux:runtime": "python3 scripts/setup_iverilog_linux.py",
    "desktop:linux": "electron-builder --config electron-builder.linux.json --linux AppImage deb rpm --x64 --publish never",
    "desktop:linux:rpm": "electron-builder --config electron-builder.linux.json --linux rpm --x64 --publish never",
    "desktop:linux:unpacked": "electron-builder --config electron-builder.linux.json --linux --x64 --dir --publish never",
    "desktop:smoke:linux": "bash scripts/test_linux_package.sh",
    "desktop:smoke:rpm": "bash scripts/test_linux_rpm.sh"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0",
    "wavedrom": "3.7.0"
  },
  "homepage": "https://github.com/YJR66/hdlbits-zh",
  "main": "desktop/main.cjs",
  "author": "HDLBits 中文学习工作台"
}
