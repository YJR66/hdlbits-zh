{
  "name": "hdlbits-zh-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HDLBits 风格的中文本地 Verilog 学习工作台",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "desktop": "electron .",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:pack": "electron-builder --config electron-builder.json --win portable --x64",
    "desktop:unpacked": "electron-builder --config electron-builder.json --win --x64 --dir"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0",
    "wavedrom": "3.7.0"
  },
  "main": "desktop/main.cjs",
  "author": "HDLBits 中文学习工作台"
}
